+                   payload={"card": {"id": "T-9999", "title": "bad",
+                                     "type": "bogus", "goalRef": "",
+                                     "scope": {"write": [], "read": []},
+                                     "acceptance": {"oracles": [],
+                                                    "evidence_required": []},
