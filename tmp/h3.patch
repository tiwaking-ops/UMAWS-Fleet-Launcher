@@ -0,0 +1,44 @@
+"""H3: Console startup must reconcile before the loops begin."""
+
+from __future__ import annotations
+
+import subprocess
+from pathlib import Path
+
+from pmk.api import Kernel
+from pmk.clock import FakeClock
+
+from _fleet_fixtures import fake_profile, make_task, write_agents
+from console.app import Console
+from fleet.dispatcher import Dispatcher
+
+
+def _git(root: Path, *args: str) -> None:
+    subprocess.run(["git", "-C", str(root), *args], check=True,
+                   capture_output=True, text=True)
+
+
+def test_console_calls_reconcile_once_on_startup(tmp_path, monkeypatch):
+    repo = tmp_path / "repo"
+    repo.mkdir()
+    _git(repo, "init", "-b", "main")
+    (repo / "src").mkdir()
+    (repo / "src" / "thing.py").write_text("VALUE = 1\n", encoding="utf-8")
+    (repo / "README.md").write_text("# test\n", encoding="utf-8")
+    _git(repo, "add", "-A")
+    _git(repo, "commit", "-m", "initial")
+
+    kernel = Kernel(root=repo, clock=FakeClock())
+    kernel.init()
+    write_agents(kernel.repo, [fake_profile()])
+    make_task(kernel)
+
+    calls = []
+
+    def spy(self):
+        calls.append(self)
+        return {"adopted": [], "lost": []}
+
+    monkeypatch.setattr(Dispatcher, "reconcile", spy)
+    Console(root=repo)
+    assert len(calls) == 1
