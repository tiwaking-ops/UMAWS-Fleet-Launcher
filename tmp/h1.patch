diff --git a/tests/pmk/test_lease_admission.py b/tests/pmk/test_lease_admission.py
new file mode 100644
index 0000000..e44b5c3
--- /dev/null
+++ b/tests/pmk/test_lease_admission.py
@@ -0,0 +1,57 @@
+"""H1: Kernel admission checks for worktree-bearing lease grants."""
+
+from __future__ import annotations
+
+import os
+
+import pytest
+
+from pmk.api import KernelError
+from _pmk_fixtures import make_card
+
+
+def _tree(kernel, name="tree"):
+    return str(kernel.repo.root.parent / name)
+
+
+def test_repo_root_worktree_is_refused(kernel):
+    card = make_card(kernel)
+    with pytest.raises(KernelError) as exc:
+        kernel.claim(card.id, holder="p", worktree=str(kernel.repo.root))
+    assert exc.value.reason == "invalid_worktree"
+    assert card.id not in kernel.state().leases
+    assert [e for e in kernel.events() if e.type == "LEASE_REFUSED"]
+
+
+def test_worktree_grant_without_pid_is_refused(kernel):
+    card = make_card(kernel)
+    with pytest.raises(KernelError) as exc:
+        kernel.claim(card.id, holder="p", worktree=_tree(kernel))
+    assert exc.value.reason == "lease_incomplete"
+    assert "pid" in exc.value.details["detail"]
+    assert card.id not in kernel.state().leases
+
+
+def test_worktree_grant_without_expiry_is_refused_even_with_pid(kernel):
+    card = make_card(kernel)
+    with pytest.raises(KernelError) as exc:
+        kernel.claim(card.id, holder="p", worktree=_tree(kernel),
+                     pid=os.getpid())
+    assert exc.value.reason == "lease_incomplete"
+    assert "expires_at" in exc.value.details["detail"]
+
+
+def test_complete_paused_worktree_grant_is_allowed(kernel):
+    card = make_card(kernel)
+    lease = kernel.claim(card.id, holder="p", worktree=_tree(kernel),
+                         pid=os.getpid(),
+                         expires_at="2099-01-01T00:00:00+00:00")
+    assert lease.worktree
+    assert lease.expires_at == "2099-01-01T00:00:00+00:00"
+
+
+def test_running_project_worktree_grant_needs_no_process_fields(kernel):
+    kernel.project_set_state("RUNNING")
+    card = make_card(kernel)
+    lease = kernel.claim(card.id, holder="p", worktree=_tree(kernel))
+    assert lease.worktree
