@@ -0,0 +1,25 @@
+"""H4: MODEL_SERVED never carries an empty model list."""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+from fleet.harness import Harness
+from fleet.profiles import Profile
+from fleet.state import FleetState
+
+from _fleet_fixtures import FIXTURE_ROOT, fake_profile, make_task
+
+
+def test_direct_profile_records_unavailable_not_empty(fake_kernel):
+    task = make_task(fake_kernel)
+    state = FleetState.load(Path(fake_kernel.repo.root) / ".pm" / "fleet-state.json")
+    harness = Harness(fake_kernel, state, fixture_root=FIXTURE_ROOT)
+    profile = Profile.from_dict(fake_profile("fake-a"))
+    run, _ = harness.start(task, profile)
+    assert run is not None
+
+    harness._record_provenance(run)
+    event = [e for e in fake_kernel.events() if e.type == "MODEL_SERVED"][-1]
+    assert event.payload["served_models"] == ["unavailable"]
+    assert event.payload["source"] != "none"
