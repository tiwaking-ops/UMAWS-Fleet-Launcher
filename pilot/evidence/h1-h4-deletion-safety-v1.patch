+def _run_git(repo, path: Path, *args: str) -> bytes:
+    code, out, err = repo.git_bytes(*args, cwd=path)
+    if code != 0:
+        message = err.decode("utf-8", "replace").strip() or "git failed"
+        raise CaptureError(f"git {' '.join(args[:2])} failed: {message}")
